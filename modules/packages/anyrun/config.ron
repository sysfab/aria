Config(
    ignore_exclusive_zones: true,
    layer: Overlay,

    x: Fraction(0.5),
    y: Fraction(0),

    width: Fraction(1),
    height: Absolute(1),

    close_on_click: true,
    show_results_immediately: false,

    hide_icons: true,
    hide_plugin_info: false,
    max_entries: None,

    plugins: [
        "libapplications.so",
        "libnix_run.so",
        "libwebsearch.so"
    ],

    keybinds: [
        Keybind(
            key: "Return",
            action: Select,
        ),
        Keybind(
            key: "Up",
            action: Up,
        ),
        Keybind(
            key: "Down",
            action: Down,
        ),
        Keybind(
            key: "Escape",
            action: Close,
        ),
    ],
)
